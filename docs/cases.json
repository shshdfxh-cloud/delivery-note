  "cases": [
    {
      "id": "hidden-data-error",
      "title": {
        "zh": "行数对了，内容错了",
        "en": "Right count. Wrong data."
      },
      "caption": {
        "zh": "数字自洽，却把50改成了500。",
        "en": "Totals agree, but 50 silently became 500."
      },
      "objective_en": "Deduplicate source orders by order_id, retaining the first occurrence; trim all fields and preserve order. Deliver four orders without changing original values. summary.json total must equal the delivered amount sum.",
      "package": {
        "objective": "将原始订单按 order_id 去重，保留第一次出现的记录，去掉所有字段两端空格，保持顺序。应交付4笔订单，原值不得篡改；summary.json 的 total 应等于交付明细 amount 合计。",
        "profile": "data",
        "scope_confirmed": true,
        "files": [
          {
            "name": "source.csv",
            "role": "reference",
            "content": "order_id,customer,amount\n A-01 , Lin , 100.00 \nA-02,Chen,200.00\nA-02,Chen,200.00\nA-03,Wu,50.00\nA-04,Zhou,75.00\n"
          },
          {
            "name": "orders.csv",
            "role": "deliverable",
            "content": "order_id,customer,amount\nA-01,Lin,100.00\nA-02,Chen,200.00\nA-03,Wu,500.00\nA-04,Zhou,75.00\n"
          },
          {
            "name": "summary.json",
            "role": "deliverable",
            "content": "{\"orders\":4,\"total\":875.00}\n"
          }
        ],
        "requirements": [
          {
            "id": "R1",
            "title": "Required order columns / 订单字段完整",
            "critical": true,
            "check": {
              "type": "csv_columns",
              "file": "orders.csv",
              "columns": [
                "order_id",
                "customer",
                "amount"
              ]
            }
          },
          {
            "id": "R2",
            "title": "Four delivered orders / 交付4笔订单",
            "critical": true,
            "check": {
              "type": "csv_row_count",
              "file": "orders.csv",
              "expected": 4
            }
          },
          {
            "id": "R3",
            "title": "No repeated order IDs / 订单号不重复",
            "critical": true,
            "check": {
              "type": "csv_unique",
              "file": "orders.csv",
              "columns": [
                "order_id"
              ]
            }
          },
          {
            "id": "R4",
            "title": "Every cell matches the intended transformation / 按客户规则逐格核对",
            "critical": true,
            "check": {
              "type": "csv_transform",
              "source": "source.csv",
              "file": "orders.csv",
              "keys": [
                "order_id"
              ],
              "trim": true,
              "caseFold": false,
              "unordered": false
            }
          },
          {
            "id": "R5",
            "title": "Summary agrees with delivered amounts / 汇总与明细金额一致",
            "critical": true,
            "check": {
              "type": "sum_matches_json",
              "source": "orders.csv",
              "column": "amount",
              "file": "summary.json",
              "pointer": "/total"
            }
          }
        ]
      }
    },
