      "package": {
        "objective": "交付能实际使用的报价网页：单价20，输入数量3显示¥60.00；输入SAVE10显示九折价¥54.00；数量为0时显示Quantity must be positive。不是只显示一个“成功”提示。",
        "profile": "web",
        "scope_confirmed": true,
        "files": [
          {
            "name": "index.html",
            "role": "deliverable",
            "content": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Order quote</title><style>body{font:18px system-ui;max-width:520px;margin:60px auto;padding:24px;background:#f3f4f6}label{display:block;margin:20px 0 8px}input,button{font:inherit;padding:10px}button{display:block;margin-top:24px}output{display:block;margin-top:24px;font-size:30px}</style><h1>Order quote</h1><p>20 per unit. SAVE10 takes 10% off.</p><label for=\"quantity\">Quantity</label><input id=\"quantity\" type=\"number\" value=\"1\"><label for=\"code\">Discount code</label><input id=\"code\"><button id=\"calculate\">Calculate</button><output id=\"total\" aria-live=\"polite\"></output><script>document.querySelector('#calculate').addEventListener('click',()=>{const q=Number(document.querySelector('#quantity').value),code=document.querySelector('#code').value;const out=document.querySelector('#total');out.textContent='¥'+(q*20).toFixed(2);});</script></html>"
          }
        ],
